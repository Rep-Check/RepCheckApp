# ── RepCheck MediaPipe API ──────────────────────────────
# Copy to .env and adjust. NEVER commit .env (secret keys).
PORT=4000

# Supabase (required for /api/v1/analyze — brief 5.2)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
VIDEOS_BUCKET=videos
VIDEO_TTL_MS=3600000        # videos auto-deleted within 1 hour
VIDEO_SWEEP_MS=900000       # how often the TTL sweep runs

# Claude coaching cues (brief 5.3 Step 7). Leave unset to use the built-in rules engine.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# PostHog analytics (free tier). Leave unset to disable analytics.
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com

# Processing limits
MAX_VIDEO_BYTES=150000000   # 150 MB (brief: file limit 150MB)
MAX_FRAMES=120              # cap on extracted frames processed
TEMP_DIR=./tmp
